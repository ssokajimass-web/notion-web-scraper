# Notion API 設定
# Notionインテグレーション作成画面 (https://www.notion.so/my-integrations) で取得したシークレット
NOTION_API_KEY=ntn_your_notion_api_key_here

# 転記先NotionデータベースID
# データベースURLの末尾などの32桁の英数字 (例: https://www.notion.so/workspace/xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx?v=...)
NOTION_DATABASE_ID=your_database_id_here

# （任意）機能ごとにデータベースを分けたい場合は以下に指定（未指定時は上記NOTION_DATABASE_IDが使われます）
NOTION_ARTICLES_DB_ID=
NOTION_SEARCH_DB_ID=
NOTION_QUOTES_DB_ID=

# クロール・スクレイピング設定
REQUEST_TIMEOUT=15
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/128.0.0.0 Safari/537.36
MAX_CONCURRENT_REQUESTS=3
REQUEST_DELAY=1.0
